APP_MODE=secured
DATABASE_URL=postgresql+asyncpg://lab:labpass@postgres:5432/app_db
REDIS_URL=redis://redis:6379
JWT_PRIVATE_KEY_PATH=secrets/private.pem
JWT_PUBLIC_KEY_PATH=secrets/public.pem
JWT_ISSUER=api-security-lab
JWT_AUDIENCE=api-security-lab-users
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100
RATE_LIMIT_ADMIN=10
DEBUG=false
LOG_LEVEL=INFO
